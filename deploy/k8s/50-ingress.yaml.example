# The API has no authentication of its own: protect it at the ingress (basic auth, OIDC proxy,
# VPN-only ingress class, ...). Rename to .yaml once adapted.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cosmad
  namespace: cosmad
  annotations:
    nginx.ingress.kubernetes.io/auth-type: basic
    nginx.ingress.kubernetes.io/auth-secret: cosmad-basic-auth
    # SSE stream (/api/v1/events) needs buffering off and a long read timeout.
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
spec:
  ingressClassName: nginx
  tls:
    - hosts: [cosmad.example.com]
      secretName: cosmad-tls
  rules:
    - host: cosmad.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: { name: cosmad, port: { name: http } }
