{
  "name": "cosmad",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/runner.ts",
    "dev:api": "NODE_ENV=development tsx src/api/main.ts",
    "dev:ingest": "NODE_ENV=development tsx src/runner.ts --no-api",
    "start": "NODE_ENV=production tsx src/runner.ts",
    "start:api": "NODE_ENV=production tsx src/api/main.ts",
    "start:ingest": "NODE_ENV=production tsx src/runner.ts --no-api",
    "build:frontend": "vue-tsc --noEmit -p src/frontend/tsconfig.json && vite build --root src/frontend",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test": "vitest",
    "prepare": "husky",
    "commit": "cz"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "4.1.5",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1",
    "@hono/node-server": "^2.0.3",
    "arktype": "^2.2.0",
    "axios": "^1.15.2",
    "camelcase": "^9.0.0",
    "camelcase-keys": "^10.0.2",
    "hono": "^4.12.21",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "smol-toml": "^1.6.1",
    "vue": "^3.5.13"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
