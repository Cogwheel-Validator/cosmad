{
  "name": "cosmad",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/runner.ts",
    "dev:engine": "NODE_ENV=development tsx src/engine/main.ts",
    "dev:ingest": "NODE_ENV=development tsx src/dp/main.ts",
    "dev:api": "NODE_ENV=development tsx src/api/main.ts",
    "start": "NODE_ENV=production node dist/runner.js",
    "start:engine": "NODE_ENV=production node dist/engine/main.js",
    "start:ingest": "NODE_ENV=production node dist/dp/main.js",
    "start:api": "NODE_ENV=production node dist/api/main.js",
    "typecheck": "tsc --noEmit",
    "vite": "vite",
    "build:frontend": "vue-tsc --noEmit -p src/frontend/tsconfig.json && vite build src/frontend && rm -rf dist/frontend && mkdir -p dist/frontend && mv src/frontend/dist dist/frontend",
    "build:backend": "pnpm run typecheck && esbuild src/runner.ts src/engine/main.ts src/dp/main.ts src/api/main.ts --bundle --platform=node --format=esm --target=esnext --outdir=dist --outbase=src --packages=external --sourcemap",
    "build": "concurrently \"pnpm run build:backend\" \"pnpm run build:frontend\"",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test": "vitest",
    "prepare": "husky",
    "commit": "cz"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "4.1.11",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@hono/node-server": "^2.1.3",
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.12.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.1",
    "arktype": "^2.2.7",
    "axios": "^1.20.0",
    "bech32": "^2.0.0",
    "camelcase": "^9.0.0",
    "camelcase-keys": "^10.0.3",
    "daisyui": "^5.7.47",
    "echarts": "^6.1.0",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-router": "^5.4.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
